<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SharedCustomTypes>foundation</SharedCustomTypes>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />
  <PropertyGroup>
    <SharedCustomTypesDir>$(MSBuildThisFileDirectory)customTypes</SharedCustomTypesDir>
    <SharedCustomTypesGeneratedFilesDir>$(BaseIntermediateOutputPath)customTypes\generated</SharedCustomTypesGeneratedFilesDir>
    <ProjectIncludeDirectories>$([System.String]::Copy('$(ProjectIncludeDirectories)').Replace('$(RuntimeNativeExternalTestPath)\$(SharedCustomTypes)\customtypes', '$(SharedCustomTypesDir)').Replace('$(RuntimeNativeExternalTestObjPath)\$(SharedCustomTypes)\customtypes\generated', '$(SharedCustomTypesGeneratedFilesDir)'))</ProjectIncludeDirectories>
    <ProjectIncludeDirectories>
        $(ProjectIncludeDirectories);
        $(RuntimeNativeExternalTestPath)\foundation\inc;
    </ProjectIncludeDirectories>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Remove="$(RuntimeNativeExternalTestPath)\$(SharedCustomTypes)\customtypes\CustomTypes.vcxproj" />
  </ItemGroup>
</Project>
