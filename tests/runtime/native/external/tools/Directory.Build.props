<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SharedCustomTypes>Tools</SharedCustomTypes>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\..\..\dxaml\test\native\external\Directory.Build.props" />
  <PropertyGroup>
    <SharedCustomTypesDir>$(MSBuildThisFileDirectory)customTypes</SharedCustomTypesDir>
    <SharedCustomTypesGeneratedFilesDir>$(BaseIntermediateOutputPath)customTypes\generated</SharedCustomTypesGeneratedFilesDir>
    <ProjectIncludeDirectories>$([System.String]::Copy('$(ProjectIncludeDirectories)').Replace('$(NativeExternalTestPath)\$(SharedCustomTypes)\customtypes', '$(SharedCustomTypesDir)').Replace('$(NativeExternalTestObjPath)\$(SharedCustomTypes)\customtypes\generated', '$(SharedCustomTypesGeneratedFilesDir)'))</ProjectIncludeDirectories>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Remove="$(NativeExternalTestPath)\$(SharedCustomTypes)\customtypes\CustomTypes.vcxproj" />
  </ItemGroup>

</Project>
