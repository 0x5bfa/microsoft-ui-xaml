  <Import Project="$(MUXControlsTestRoot)interactiontests\Expander\Expander_InteractionTests.projitems" Label="Shared" Condition="$(FeatureExpanderEnabled) == 'true'" />
  <Import Project="$(MUXControlsTestRoot)interactiontests\PagerControl\PagerControl_InteractionTests.projitems" Label="Shared" Condition="$(FeaturePagerControlEnabled) == 'true'" />
