* text=auto

# Force specific files that git doesn't know should always be CRLF
*.idl text eol=crlf
*.h text eol=crlf
*.cpp text eol=crlf
*.sln text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*proj text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# GitHub Linguist: include only C++ and C# in language stats.
* -linguist-detectable

*.cpp linguist-detectable linguist-language=C++
*.cxx linguist-detectable linguist-language=C++
*.cc linguist-detectable linguist-language=C++
*.c linguist-detectable linguist-language=C++
*.h linguist-detectable linguist-language=C++
*.hpp linguist-detectable linguist-language=C++
*.hxx linguist-detectable linguist-language=C++
*.inl linguist-detectable linguist-language=C++

*.cs linguist-detectable linguist-language=C#
